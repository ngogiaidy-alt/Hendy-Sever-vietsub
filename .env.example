# ==============================================================================
# Hendy-Server Environment Configuration Template
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- 1. GitHub OAuth & Integration ---
# Register at https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="hendy_secure_webhook_secret_2026"
GITHUB_TOKEN="ghp_optional_personal_access_token_for_private_repos"

# --- 2. Database & Message Queue ---
POSTGRES_DB="hendy_db"
POSTGRES_USER="hendy_admin"
POSTGRES_PASSWORD="hendy_secure_pass_2026"
DATABASE_URL="postgresql://hendy_admin:hendy_secure_pass_2026@localhost:5432/hendy_db"

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- 3. VIETSUB PRO & Python Engine ---
WHISPER_MODEL="large-v3" # tiny, base, small, medium, large-v3
ENABLE_CUDA="1"
MAX_STREAM_TABS="20"
DUCKING_ATTENUATION_DB="-14.0"
DUCKING_THRESHOLD_DB="-22.0"
WORKSPACE_ROOT="/tmp/hendy_builds"

# --- 4. Cloud Storage (Cloudflare R2 / AWS S3) ---
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="your_r2_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_r2_secret_access_key"
STORAGE_BUCKET="hendy-media-archive"
